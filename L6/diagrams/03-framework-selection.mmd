%% L6 图 03：框架选型决策图
%% 中文注释：先判断核心业务约束，再进入具体框架的能力验证。
flowchart TD
    A["准备构建 Agent 应用"] --> B{"是否存在严格步骤、条件分支、回退或审计？"}
    B -- "是" --> LG["优先 LangGraph<br/>显式 State、Node、Edge"]
    B -- "否" --> C{"是否需要大量并发、分布式、容错和长期运行？"}
    C -- "是" --> AS["优先 AgentScope<br/>工程化多 Agent 平台"]
    C -- "否" --> D{"是否主要是两位互补专家自主深度协作？"}
    D -- "是" --> CA["优先 CAMEL<br/>角色扮演与引导性提示"]
    D -- "否" --> E{"是否需要多个角色讨论、评审和动态交接？"}
    E -- "是" --> AG["优先 AutoGen<br/>GroupChat 与 Team"]
    E -- "否" --> F["先评估单 Agent 或轻量自定义实现"]

    LG --> V["用最小案例验证状态、成本和可观测性"]
    AS --> V
    CA --> V
    AG --> V
    F --> V
    V --> R{"验证结果是否满足业务约束？"}
    R -- "否" --> A
    R -- "是" --> END["确定框架并进入工程设计"]

    N["中文选型口诀：先流程，再工程，再角色规模"] -.-> A

